# Copy to config.local/account-structure.env and fill in real values.
# config.local/ is gitignored. See RUNBOOK.md for where each value comes from.
AWS_PROFILE=admin
AWS_REGION=us-east-1
ORGANIZATION_ROOT_ID=<root id, r-...>
AGENT_ACCOUNT_NAME=agents
AGENT_ACCOUNT_EMAIL=agents@example.com
PRODUCTION_ACCOUNT_NAME=production
PRODUCTION_ACCOUNT_EMAIL=production@example.com
IDENTITY_CENTER_INSTANCE_ARN=<arn:aws:sso:::instance/ssoins-...>
BUILDER_PERMISSION_SET_ARN=<Agent-Builder permission set ARN>
READONLY_PERMISSION_SET_ARN=<Agent-ReadOnly permission set ARN>
ADMIN_PERMISSION_SET_ARN=<Admin permission set ARN>
AGENT_PRINCIPAL_ID=<Identity Center user ID of the dedicated agent user>
ADMIN_PRINCIPAL_ID=<Identity Center user ID of your own user>
PRINCIPAL_TYPE=USER
